#!/usr/bin/env bash
# Auto-build & auto-commit + push after source changes
# Skip with: SKIP_BUILD=1 git commit ...
# Install: git config core.hooksPath .githooks

[ -n "$SKIP_BUILD" ] && exit 0

# Only run on main branch
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
[ "$BRANCH" != "main" ] && exit 0

# Detect if last commit touched source files (content/, templates/, build.py, .githooks/)
LAST_FILES=$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null)
ONLY_DOCS=true
for f in $LAST_FILES; do
    case "$f" in
        docs/*) ;;
        *) ONLY_DOCS=false; break ;;
    esac
done

# If only docs/ changed, we already built — skip to avoid loops
[ "$ONLY_DOCS" = true ] && exit 0

echo ""
echo "━━━ Auto-build triggered by source changes ━━━"
echo ""

# Rebuild
python build.py
BUILD_EXIT=$?
if [ $BUILD_EXIT -ne 0 ]; then
    echo "✕ Build failed (exit $BUILD_EXIT), not committing"
    exit 1
fi

# Check if docs/ has unstaged changes
if ! git diff --quiet HEAD -- docs/; then
    git add -A docs/
    git commit -m "chore: auto-build docs [skip ci]"
    echo "✓ Built & committed docs/"

    # Push
    git push origin main
    echo "✓ Pushed to origin/main — deployment should start automatically"
else
    echo "No changes in docs/, nothing to commit"
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
